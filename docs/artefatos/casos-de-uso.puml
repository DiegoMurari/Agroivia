@startuml cu-1-acesso
!pragma layout smetana
skinparam shadowing false
skinparam dpi 120
skinparam actorStyle awesome
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #005BA0
skinparam rectangleBackgroundColor #F4F7FA
skinparam usecaseBorderColor #005BA0
title 1 de 6 · Acesso e aprovações
actor "Fornecedor" as FOR
actor "Compras" as COM
actor "Adm Master" as ADM
rectangle "Recebimento Inteligente" {
  usecase "UC01 Entrar no sistema\n(login por perfil)" as UC01
  usecase "UC02 Cadastrar fornecedor\npor convite" as UC02
  usecase "UC03 Aprovar ou recusar\ncadastro de fornecedor" as UC03
  usecase "UC04 Aprovar ou recusar\npedido do fornecedor" as UC04
  usecase "UC05 Gerir usuários e perfis" as UC05
  usecase "UC06 Recuperar senha" as UC06
  usecase "UC07 Ver notificações" as UC07
  usecase "UC08 Enviar convite\nde cadastro" as UC08
}
FOR --> UC01
FOR --> UC02
FOR --> UC06
FOR --> UC07
COM --> UC01
COM --> UC03
COM --> UC04
COM --> UC08
COM --> UC07
ADM --> UC01
ADM --> UC05
ADM --> UC03
UC02 ..> UC01 : <<extend>>
UC03 ..> UC07 : <<include>>
UC04 ..> UC07 : <<include>>
@enduml

