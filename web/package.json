{
  "name": "recebimento-inteligente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"console.error('Use npm run dev:s1, dev:s2 ou dev:s3 (porta, build e banco por janela). Demo: npm run build e npm run start.');process.exit(1)\"",
    "build": "next build",
    "start": "cross-env DB_PATH=data/demo.db next start -p 8000",
    "lint": "eslint",
    "dev:s1": "cross-env NEXT_DIST_DIR=.next-s1 DB_PATH=data/s1.db next dev -p 8001",
    "dev:s2": "cross-env NEXT_DIST_DIR=.next-s2 DB_PATH=data/s2.db next dev -p 8002",
    "dev:s3": "cross-env NEXT_DIST_DIR=.next-s3 DB_PATH=data/s3.db next dev -p 8003",
    "test": "vitest run",
    "test:s0": "vitest run lib/money lib/relogio lib/origem lib/http lib/papel lib/db/ scripts/ --passWithNoTests",
    "test:s1": "vitest run lib/agendamento/ lib/fornecedor/ --passWithNoTests",
    "test:s2": "vitest run lib/boletim/ lib/cadastros/ lib/dia/ lib/usuarios/ --passWithNoTests",
    "test:s3": "vitest run lib/painel/ lib/aprovacoes/ --passWithNoTests",
    "tsc:s0": "tsc --noEmit -p tsconfig.s0.json",
    "tsc:s1": "tsc --noEmit -p tsconfig.s1.json",
    "tsc:s2": "tsc --noEmit -p tsconfig.s2.json",
    "tsc:s3": "tsc --noEmit -p tsconfig.s3.json",
    "lint:s1": "eslint app/agendamento app/api/agendamento lib/agendamento components/agendamento app/fornecedor app/api/fornecedor lib/fornecedor components/fornecedor --no-error-on-unmatched-pattern",
    "lint:s2": "eslint app/boletim app/api/boletim lib/boletim components/boletim app/cadastros app/api/cadastros lib/cadastros components/cadastros app/dia app/api/dia lib/dia components/dia app/usuarios app/api/usuarios lib/usuarios components/usuarios --no-error-on-unmatched-pattern",
    "lint:s3": "eslint app/painel app/api/painel lib/painel components/painel app/aprovacoes app/api/aprovacoes lib/aprovacoes components/aprovacoes app/cadastro app/api/cadastro --no-error-on-unmatched-pattern",
    "run:s1": "cross-env DB_PATH=data/s1.db tsx --env-file-if-exists=.env",
    "run:s2": "cross-env DB_PATH=data/s2.db tsx --env-file-if-exists=.env",
    "run:s3": "cross-env DB_PATH=data/s3.db tsx --env-file-if-exists=.env",
    "db:rebuild": "tsx --env-file-if-exists=.env scripts/db-rebuild.ts",
    "db:clone": "tsx --env-file-if-exists=.env scripts/db-clone.ts",
    "db:clone:s1": "tsx --env-file-if-exists=.env scripts/db-clone.ts s1",
    "db:clone:s2": "tsx --env-file-if-exists=.env scripts/db-clone.ts s2",
    "db:clone:s3": "tsx --env-file-if-exists=.env scripts/db-clone.ts s3",
    "db:clone:demo": "tsx --env-file-if-exists=.env scripts/db-clone.ts demo",
    "demo:preparar": "tsx --env-file-if-exists=.env scripts/preparar-apresentacao.ts",
    "seed:agendamento": "cross-env DB_PATH=data/s1.db tsx --env-file-if-exists=.env scripts/seed-modulo.ts agendamento",
    "seed:boletim": "cross-env DB_PATH=data/s2.db tsx --env-file-if-exists=.env scripts/seed-modulo.ts boletim",
    "seed:painel": "cross-env DB_PATH=data/s3.db tsx --env-file-if-exists=.env scripts/seed-modulo.ts painel",
    "import:hist": "cross-env DB_PATH=data/s3.db tsx --env-file-if-exists=.env lib/painel/importar/run.ts",
    "e2e": "playwright test",
    "artefatos:png": "tsx --env-file-if-exists=.env scripts/artefatos-png.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.49.0",
    "mermaid": "^12.1.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
