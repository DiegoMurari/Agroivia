# Copie para .env (fora do git). Sem DB_PATH aqui: cada script do package.json fixa o seu banco (D04).

# Pasta do pacote de dados da Agrovia, fora do repositório. Barras normais, sem aspas.
PACOTE_DIR=C:/caminho/para/DADOS_HACKATHON_2026

# Origem das linhas novas: teste no evento, operacao em uso real (D06, D37).
ORIGEM_PADRAO=teste

# Relógio da demo: uma segunda-feira de manhã. Apague a linha para usar a hora real.
DEMO_AGORA=2026-08-31T07:45:00-03:00

# Consulta em linguagem natural (grupo 3, D32): opcional. Sem a chave, a tela usa só as consultas fixas.
ANTHROPIC_API_KEY=

# Segredo que assina o cookie de sessão (D49). Gere um valor longo e aleatório.
AUTH_SECRET=troque-por-um-valor-aleatorio-de-64-caracteres

# Primeiro Adm Master, criado pelo db:rebuild (D49). A senha é trocada no primeiro acesso em produção.
ADM_MASTER_EMAIL=adm@agrovia.com.br
ADM_MASTER_SENHA=troque-esta-senha
